# Environment Configuration
ENVIRONMENT=development
PORT=8501

# Google API (Vision / Gemini for OCR and Scene Prior Analysis)
GOOGLE_API_KEY=

# Google Cloud Storage (GCS for Media Blobs)
GCP_PROJECT_ID=
GCS_BUCKET_NAME=anti-gravity-evidence-lens-media

# Vector Database / Search Engine (e.g., Pinecone, Milvus)
VECTOR_DB_API_KEY=
VECTOR_DB_ENVIRONMENT=
VECTOR_DB_INDEX_NAME=sitelens-core-index

# Analytics & Monitoring
TELEMETRY_ENABLED=true
